# ─────────────────────────────────────────────────────────
#  sbom-analyzer Terraform Variables
#  Copy this file to terraform.tfvars and fill in the values
# ─────────────────────────────────────────────────────────

# Required — your Azure subscription ID
subscription_id = "00000000-0000-0000-0000-000000000000"

# Required — Grafana admin password
grafana_admin_password = "change-me"

# Required — Gmail account used to SEND alert emails.
# Needs 2FA enabled and an App Password generated.
# Generate App Password at: https://myaccount.google.com/apppasswords
alertmanager_smtp_username = "you@gmail.com"
alertmanager_smtp_password = "xxxx xxxx xxxx xxxx"

# Optional — override defaults
# location                = "canadacentral"
# resource_group_name     = "rg-sbom"
# cluster_name            = "aks-sbom"
# node_vm_size            = "Standard_D2as_v5"
# node_count              = 1
# node_min_count          = 1
# node_max_count          = 2
# key_vault_name          = "kv-sbom-dev"
# dns_zone_name           = "reon.buzz"
# dns_zone_resource_group = "sa"
# app_namespace           = "sbom"
